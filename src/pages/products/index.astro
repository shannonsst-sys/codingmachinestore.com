---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AddToCartButton from '../../components/AddToCartButton';
import { categories, getChildren } from '../../data/categories';
import { products } from '../../data/products';

const departments = categories.filter((category) => category.featured);
---
<SiteLayout title="Products | Coding Machine Store" description="Inkjet printers and coding machines, organized by application.">
  <section class="category-hero products-hero"><span class="eyebrow">Product catalogue</span><h1>Choose your coding system.</h1><p>Browse the complete product structure: inkjet printers for production lines, plus coding machines organized by ribbon and ink roller technology.</p></section>
  <section class="section"><div class="section-heading"><div><span class="eyebrow">Product families</span><h2>One catalogue, clear paths.</h2></div><p class="section-intro">The two current products are live under Coding machines → Ribbon. Inkjet and Ink roller products can be added without changing the site structure.</p></div><div class="department-grid">{departments.map((department) => <div class="department-card"><div><span class="eyebrow">{department.label}</span><h3>{department.title}</h3><p>{department.description}</p></div><a class="button button-dark" href={`/category/${department.slug}/`}>Explore {department.label.toLowerCase()} →</a>{getChildren(department.slug).length > 0 && <div class="department-children">{getChildren(department.slug).map((child) => <a href={`/category/${child.slug}/`}><span>{child.label}</span><b>{child.title}</b><em>→</em></a>)}</div>}</div>)}</div></section>
  <section class="section" id="all-products"><div class="section-heading"><div><span class="eyebrow">Ready to quote</span><h2>Current products.</h2></div><p class="section-intro">Prices are clear and shipping is calculated separately after you provide the delivery address.</p></div><div class="product-grid">{products.map((product) => <article class="product-card"><a class="product-card-media" href={`/products/${product.slug}/`}><img src={product.hero} alt={product.name} /></a><div class="product-card-body"><span class="eyebrow">Coding machines · {product.subcategory}</span><h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3><p>{product.description}</p><div class="product-meta"><span class="price">${product.price.toFixed(2)}</span><AddToCartButton client:load id={product.slug} name={`${product.model} ${product.name}`} price={product.price} /></div></div></article>)}</div></section>
</SiteLayout>
