---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductGallery from '../../components/ProductGallery';
import ImageLightbox from '../../components/ImageLightbox';
import AddToCartButton from '../../components/AddToCartButton';
import ProductQuoteOptions from '../../components/ProductQuoteOptions';
import { getCategory } from '../../data/categories';
import { products } from '../../data/products';
export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const machineCategory = getCategory(product.category);
const applications = product.applications.split(' · ');
const priceLabel = product.priceLabel ?? `$${product.price.toFixed(2)}`;
const priceUnit = product.priceUnit ?? 'USD / unit';
const productVideo = product.videoUrl ? {
  url: product.videoUrl,
  embedUrl: product.videoUrl.replace('/shorts/', '/embed/').split('?')[0],
  aspectRatio: product.videoAspectRatio ?? '16 / 9',
} : null;
const videoOrientation = productVideo?.aspectRatio === '9 / 16' ? 'is-portrait' : 'is-landscape';
const relatedAccessories = (product.relatedAccessories ?? [])
  .map((slug) => products.find((candidate) => candidate.slug === slug))
  .filter((accessory): accessory is (typeof products)[number] => Boolean(accessory));
const reservedAccessorySlots = [
  { label: 'Ribbon', description: 'Compatible ribbon consumables for this machine.' },
  { label: 'Copper character head', description: 'Replacement copper heads and ribbon coding accessories.' },
];
---
<SiteLayout title={`${product.model} | Coding Machine Store`} description={product.description}>
  <div class="breadcrumbs"><a href="/">Home</a> / <a href="/products/">Products</a> / <a href={`/category/${product.category}/`}>{machineCategory?.title ?? product.type}</a> / {product.model}</div>
  <section class="product-layout"><ProductGallery client:load name={`${product.model} ${product.name}`} images={product.gallery} /><div class="product-info"><span class="eyebrow">{product.model} · {product.subcategory} · {product.type}</span><h1>{product.name}</h1><p class="lead">{product.description}</p><div class="product-price">{priceLabel} <small>{priceUnit}</small></div>{product.options?.length ? <ProductQuoteOptions client:load id={product.slug} name={product.name} options={product.options} notesPrompt={product.notesPrompt} /> : <AddToCartButton client:load id={product.slug} name={`${product.model} ${product.name}`} price={product.price} />}<a class="button" href="/#quote">Go to quote form →</a><div class="product-jump"><a href="#product-details">Product details ↓</a></div><p class="shipping-note"><strong>Shipping calculated separately.</strong><br />Add this product to your quote list, then complete the Formspree form.</p></div></section>
  {productVideo && <section class="product-video" aria-labelledby="product-video-title"><div class="product-video-copy"><span class="eyebrow">See it in action</span><h2 id="product-video-title">Watch the DY-8 make a clean mark.</h2><p>This short video shows the manual hot ribbon coding process. The video keeps its original format and adapts cleanly on desktop and mobile.</p><a class="text-link" href={productVideo.url} target="_blank" rel="noreferrer">Open on YouTube ↗</a></div><div class={`product-video-frame ${videoOrientation}`} style={`--video-aspect-ratio:${productVideo.aspectRatio}`}><iframe src={productVideo.embedUrl} title={`${product.model} demonstration video`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></section>}
  {relatedAccessories.length > 0 && <section class="related-accessories" id="compatible-accessories"><div class="section-heading"><div><span class="eyebrow">Compatible accessories</span><h2>Build your complete setup.</h2></div><p>Choose the parts that fit this machine. They will be added to the same quote list as your equipment.</p></div><div class="accessory-grid">{relatedAccessories.map((accessory) => <article class="accessory-card"><div class="accessory-card-media"><img src={accessory.hero} alt={`${accessory.name} compatible with ${product.model}`} loading="lazy" /></div><div class="accessory-card-body"><span class="eyebrow">{accessory.type}</span><h3>{accessory.name}</h3><p>{accessory.description}</p><div class="accessory-card-footer"><strong>{accessory.priceLabel ?? `$${accessory.price.toFixed(2)}`}</strong><a class="button button-dark" href={`/products/${accessory.slug}/`}>Choose options →</a></div></div></article>)}{reservedAccessorySlots.map((slot) => <article class="accessory-card accessory-card-placeholder"><div class="accessory-placeholder-mark">+</div><span class="eyebrow">Coming soon</span><h3>{slot.label}</h3><p>{slot.description}</p><span class="accessory-status">Product slot reserved</span></article>)}</div></section>}
  <section class="details" id="product-details"><div><span class="eyebrow">Product notes</span><h2>Built for a<br /><em>cleaner mark.</em></h2><p>{product.longDescription}</p><div class="details-applications"><span class="eyebrow">Recommended applications</span><p>{applications.join(' · ')}</p></div></div><div class="details-specifications"><span class="eyebrow">Specifications</span><dl class="specs">{product.specs.map(([label, value]) => <div class="spec"><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></section>
  <section class="product-story" id="product-images"><div class="story-copy"><span class="eyebrow">Product details</span><h2>Understand the machine.</h2><p>{product.longDescription}</p><h3>Typical applications</h3><ul>{applications.map((application) => <li>{application}</li>)}</ul></div><figure class="story-image"><ImageLightbox client:load src={product.detailGallery[0]} alt={`${product.model} product overview`} /><figcaption>{product.model} product overview</figcaption></figure><figure class="story-image"><ImageLightbox client:load src={product.detailGallery[1]} alt={`${product.model} operating detail`} /><figcaption>Operating structure and working area</figcaption></figure><div class="story-copy story-copy-secondary"><span class="eyebrow">Why this model</span><h3>{product.badge}</h3><p>Review the machine from every angle, then send the product and your delivery address with the quote so we can confirm compatibility and shipping.</p><a href="https://wa.me/8618702620038">Ask on WhatsApp →</a></div></section>
  <section class="detail-gallery"><div class="detail-gallery-heading"><span class="eyebrow">Image details</span><h2>See the machine up close.</h2></div>{product.detailGallery.map((image, index) => <figure><ImageLightbox client:load src={image} alt={`${product.model} product detail ${index + 1}`} /><figcaption>{product.model} detail {String(index + 1).padStart(2, '0')}</figcaption></figure>)}</section>
</SiteLayout>
