---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductGallery from '../../components/ProductGallery';
import ImageLightbox from '../../components/ImageLightbox';
import AddToCartButton from '../../components/AddToCartButton';
import { getCategory } from '../../data/categories';
import { products } from '../../data/products';
export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const machineCategory = getCategory(product.category);
const applications = product.applications.split(' · ');
---
<SiteLayout title={`${product.model} | Coding Machine Store`} description={product.description}>
  <div class="breadcrumbs"><a href="/">Home</a> / <a href="/products/">Products</a> / <a href={`/category/${product.category}/`}>{machineCategory?.title ?? product.type}</a> / {product.model}</div>
  <section class="product-layout"><ProductGallery client:load name={`${product.model} ${product.name}`} images={product.gallery} /><div class="product-info"><span class="eyebrow">{product.model} · {product.subcategory} coding machine</span><h1>{product.name}</h1><p class="lead">{product.description}</p><div class="product-price">${product.price.toFixed(2)} <small>USD / unit</small></div><AddToCartButton client:load id={product.slug} name={`${product.model} ${product.name}`} price={product.price} /><a class="button" href="https://formspree.io/f/xppalleq">Request a quote with this product →</a><div class="product-jump"><a href="#product-details">Product details ↓</a><a href="#specifications">Specifications ↓</a></div><p class="shipping-note"><strong>Shipping calculated separately.</strong><br />Send your delivery address with the quote and we will reply with the best available shipping option.</p></div></section>
  <section class="details" id="product-details"><div><span class="eyebrow">Product notes</span><h2>Built for a<br /><em>cleaner mark.</em></h2><p>{product.longDescription}</p><div class="details-applications"><span class="eyebrow">Recommended applications</span><p>{applications.join(' · ')}</p></div></div><div class="details-specifications"><span class="eyebrow">Specifications</span><dl class="specs">{product.specs.map(([label, value]) => <div class="spec"><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></section>
  <section class="product-story" id="product-images"><div class="story-copy"><span class="eyebrow">Product details</span><h2>Understand the machine.</h2><p>{product.longDescription}</p><h3>Typical applications</h3><ul>{applications.map((application) => <li>{application}</li>)}</ul></div><figure class="story-image"><ImageLightbox client:load src={product.detailGallery[0]} alt={`${product.model} product overview`} /><figcaption>{product.model} product overview</figcaption></figure><figure class="story-image"><ImageLightbox client:load src={product.detailGallery[1]} alt={`${product.model} operating detail`} /><figcaption>Operating structure and working area</figcaption></figure><div class="story-copy story-copy-secondary"><span class="eyebrow">Why this model</span><h3>{product.badge}</h3><p>Review the machine from every angle, then send the product and your delivery address with the quote so we can confirm compatibility and shipping.</p><a href="https://wa.me/8618702620038">Ask on WhatsApp →</a></div></section>
  <section class="specifications" id="specifications"><div class="section-heading"><div><span class="eyebrow">Technical table</span><h2>Specifications.</h2></div><p class="section-intro">The key operating information is presented in a quick-reference table for comparison and quoting.</p></div><div class="spec-table-wrap"><table class="spec-table"><thead><tr><th>Specification</th><th>Details</th></tr></thead><tbody>{product.specs.map(([label, value]) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table></div></section>
  <section class="detail-gallery"><div class="detail-gallery-heading"><span class="eyebrow">Image details</span><h2>See the machine up close.</h2></div>{product.detailGallery.map((image, index) => <figure><ImageLightbox client:load src={image} alt={`${product.model} product detail ${index + 1}`} /><figcaption>{product.model} detail {String(index + 1).padStart(2, '0')}</figcaption></figure>)}</section>
</SiteLayout>
