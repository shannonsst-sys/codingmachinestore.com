---
import { products } from '../data/products';

const inquirySeed = [
  { id: 'Q-1048', customer: 'Maya Chen', company: 'Northline Foods', request: 'HP-241B · 2 units', date: 'Today, 09:42', status: 'New', priority: 'High', initials: 'MC', tone: 'amber' },
  { id: 'Q-1047', customer: 'Owen Smith', company: 'PackRight Ltd.', request: 'Copper type box · 10 sets', date: 'Yesterday, 16:18', status: 'In review', priority: 'Normal', initials: 'OS', tone: 'blue' },
  { id: 'Q-1046', customer: 'Lina Wu', company: 'FreshDrop Co.', request: 'DY-8 · 5 units', date: 'Aug 17, 11:06', status: 'Quoted', priority: 'Normal', initials: 'LW', tone: 'green' },
  { id: 'Q-1045', customer: 'Ethan Bell', company: 'Belltown Pharma', request: 'Copper characters · Custom', date: 'Aug 16, 14:30', status: 'In review', priority: 'High', initials: 'EB', tone: 'purple' },
  { id: 'Q-1044', customer: 'Ava Patel', company: 'Nourish Lab', request: 'HP-241B · 1 unit', date: 'Aug 15, 10:22', status: 'Closed', priority: 'Normal', initials: 'AP', tone: 'rose' },
];

const inventory = Object.fromEntries(products.map((product, index) => [product.slug, index === 0 ? 18 : index === 1 ? 9 : 32]));
const catalogValue = products.reduce((sum, product) => sum + product.price, 0);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>后台 · Coding Machine Store</title>
  </head>
  <body>
    <div class="admin-shell">
      <aside class="admin-sidebar" id="admin-sidebar">
        <div class="sidebar-topline"><span class="status-dot"></span> Store operations</div>
        <a class="admin-brand" href="/" aria-label="返回前台"><span class="brand-mark">CM</span><span>CODING<br /><b>MACHINE</b></span></a>
        <nav class="admin-nav" aria-label="后台导航">
          <p class="nav-label">Workspace</p>
          <button class="nav-item is-active" data-view-target="overview"><span class="nav-icon">⌂</span> 总览</button>
          <button class="nav-item" data-view-target="products"><span class="nav-icon">▦</span> 商品目录 <span class="nav-count">{products.length}</span></button>
          <button class="nav-item" data-view-target="inquiries"><span class="nav-icon">✉</span> 询盘 <span class="nav-count nav-count-accent">5</span></button>
          <p class="nav-label nav-label-spaced">System</p>
          <button class="nav-item" data-view-target="settings"><span class="nav-icon">⚙</span> 设置</button>
        </nav>
        <div class="sidebar-bottom">
          <div class="demo-note"><span class="demo-note-dot"></span><div><strong>演示模式</strong><small>数据暂存于当前页面</small></div></div>
          <a class="back-store" href="/"><span>↗</span> 返回前台商店</a>
        </div>
      </aside>

      <main class="admin-main">
        <header class="admin-header">
          <button class="mobile-menu" id="mobile-menu" aria-label="打开菜单">☰</button>
          <div class="breadcrumb"><span>Workspace</span><b>/</b><strong id="breadcrumb-current">总览</strong></div>
          <div class="header-actions">
            <span class="header-date">Aug 19, 2026</span>
            <a class="storefront-link" href="/" target="_blank" rel="noreferrer">查看前台 <span>↗</span></a>
            <div class="profile-chip"><span class="profile-avatar">A</span><span class="profile-name">Admin</span><span class="profile-chevron">⌄</span></div>
          </div>
        </header>

        <div class="admin-content">
          <section class="admin-view is-visible" data-view="overview">
            <div class="page-heading"><div><span class="eyebrow">Wednesday · 19 August 2026</span><h1>早上好，Admin <span class="heading-wave">✳</span></h1><p>这里是你的打码机商店运营概览。</p></div><button class="primary-button" data-open-modal="product-modal"><span>＋</span> 新增商品</button></div>
            <div class="metric-grid">
              <article class="metric-card metric-card-dark"><div class="metric-label">有效商品 <span class="metric-trend trend-light">+1 this month</span></div><strong>{products.length}</strong><div class="metric-foot"><span class="mini-bars bars-light"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span>Product catalogue</span></div></article>
              <article class="metric-card"><div class="metric-label">待处理询盘 <span class="metric-trend trend-up">+3 new</span></div><strong>5</strong><div class="metric-foot"><span class="status-pill status-new">需要关注</span><span>Last 7 days</span></div></article>
              <article class="metric-card"><div class="metric-label">本月成交额 <span class="metric-trend trend-up">↑ 12.8%</span></div><strong>$2,480</strong><div class="metric-foot"><span class="mini-bars bars-accent"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span>vs. $2,200 last month</span></div></article>
              <article class="metric-card"><div class="metric-label">平均回复时间 <span class="metric-trend trend-neutral">-18 min</span></div><strong>2h 14m</strong><div class="metric-foot"><span class="speed-dot"></span><span>Keep it under 4 hours</span></div></article>
            </div>

            <div class="overview-grid">
              <article class="panel chart-panel"><div class="panel-heading"><div><span class="eyebrow">Quote activity</span><h2>询盘趋势</h2></div><select class="period-select" aria-label="选择时间范围"><option>Last 30 days</option><option>Last 7 days</option><option>This year</option></select></div><div class="chart-summary"><strong>38</strong><span>total inquiries</span><b>+18.4%</b></div><div class="bar-chart" aria-label="最近六个月询盘数量图表"><div class="chart-y-axis"><span>20</span><span>15</span><span>10</span><span>5</span><span>0</span></div><div class="chart-bars"><div class="chart-gridline"></div><div class="chart-gridline"></div><div class="chart-gridline"></div><div class="chart-gridline"></div>{[['Mar','41%'],['Apr','58%'],['May','52%'],['Jun','76%'],['Jul','64%'],['Aug','91%']].map(([month, height]) => <div class="chart-column"><div class="chart-bar" style={`height:${height}`}><span>{month === 'Aug' ? '11' : month === 'Jun' ? '9' : month === 'Jul' ? '8' : month === 'Apr' ? '7' : month === 'May' ? '6' : '5'}</span></div><small>{month}</small></div>)}</div></div></article>
              <article class="panel quick-panel"><div class="panel-heading"><div><span class="eyebrow">Shortcuts</span><h2>快速操作</h2></div><span class="panel-kicker">⌘ K</span></div><div class="shortcut-list"><button class="shortcut-item" data-open-modal="product-modal"><span class="shortcut-icon shortcut-icon-amber">＋</span><span><strong>新增商品</strong><small>发布一款新的打码设备</small></span><b>→</b></button><button class="shortcut-item" data-switch-view="inquiries"><span class="shortcut-icon shortcut-icon-blue">✉</span><span><strong>处理询盘</strong><small>还有 5 条询盘待跟进</small></span><b>→</b></button><button class="shortcut-item" data-switch-view="products"><span class="shortcut-icon shortcut-icon-green">▦</span><span><strong>查看库存</strong><small>{Object.values(inventory).reduce((sum, value) => sum + value, 0)} 件商品可用</small></span><b>→</b></button></div><div class="tip-card"><span>✦</span><p><strong>运营小贴士</strong><br />HP-241B 本月浏览量最高，考虑在首页增加一个快捷入口。</p></div></article>
            </div>

            <div class="bottom-grid"><article class="panel recent-panel"><div class="panel-heading"><div><span class="eyebrow">Needs your attention</span><h2>最新询盘</h2></div><button class="text-button" data-switch-view="inquiries">查看全部 →</button></div><div class="inquiry-preview-list">{inquirySeed.slice(0, 3).map((inquiry) => <button class="inquiry-preview" data-inquiry-id={inquiry.id}><span class={`inquiry-avatar avatar-${inquiry.tone}`}>{inquiry.initials}</span><span class="inquiry-preview-main"><strong>{inquiry.customer}</strong><small>{inquiry.company} · {inquiry.request}</small></span><span class="inquiry-preview-side"><em class={`priority priority-${inquiry.priority.toLowerCase()}`}>{inquiry.priority}</em><small>{inquiry.date}</small></span></button>)}</div></article><article class="panel catalog-panel"><div class="panel-heading"><div><span class="eyebrow">Catalogue health</span><h2>商品状态</h2></div><button class="text-button" data-switch-view="products">管理目录 →</button></div><div class="catalog-health"><div class="health-ring"><span>{products.length}</span><small>live</small></div><div class="health-legend"><span><i class="legend-dot legend-live"></i>已上线 <b>{products.length}</b></span><span><i class="legend-dot legend-draft"></i>草稿 <b>1</b></span><span><i class="legend-dot legend-offline"></i>缺货 <b>0</b></span></div></div><div class="catalog-footer"><span>目录完整度</span><strong>92%</strong><div class="progress-track"><i style="width:92%"></i></div></div></article></div>
          </section>

          <section class="admin-view" data-view="products">
            <div class="page-heading"><div><span class="eyebrow">Catalogue management</span><h1>商品目录</h1><p>管理你的设备、配件和前台展示状态。</p></div><button class="primary-button" data-open-modal="product-modal"><span>＋</span> 新增商品</button></div>
            <div class="toolbar"><div class="search-wrap"><span>⌕</span><input id="product-search" type="search" placeholder="搜索商品、型号或分类…" /></div><select id="product-filter" class="toolbar-select" aria-label="筛选商品"><option value="all">全部状态</option><option value="live">已上线</option><option value="low">库存偏低</option><option value="draft">草稿</option></select><button class="ghost-button">导出 CSV <span>↓</span></button></div>
            <div class="panel table-panel"><div class="table-caption"><span><strong id="product-result-count">{products.length}</strong> 个商品</span><span class="caption-muted">最后更新：今天 09:42</span></div><div class="table-scroll"><table class="data-table product-table"><thead><tr><th>商品</th><th>分类</th><th>价格</th><th>库存</th><th>状态</th><th></th></tr></thead><tbody id="product-table-body">{products.map((product) => { const stock = inventory[product.slug]; return <tr data-product-row data-name={`${product.name} ${product.model} ${product.category}`.toLowerCase()} data-stock={stock} data-status={stock < 12 ? 'low' : 'live'}><td><div class="product-cell"><span class="product-thumb"><img src={product.hero} alt="" /></span><span><strong>{product.name}</strong><small>{product.model}</small></span></div></td><td><span class="category-tag">{product.type}</span></td><td><strong class="price-cell">{product.priceLabel ?? `$${product.price.toFixed(2)}`}</strong></td><td><span class={`stock-value ${stock < 12 ? 'stock-low' : ''}`}><i></i>{stock} units</span></td><td><span class="table-status status-live">Live</span></td><td><div class="row-actions"><button class="icon-button edit-product" title="编辑商品" data-product={product.slug}>⋯</button><a class="row-link" href={`/products/${product.slug}/`} target="_blank" rel="noreferrer">↗</a></div></td></tr>})}</tbody></table></div><div class="empty-state" id="product-empty">没有找到匹配的商品。</div></div>
          </section>

          <section class="admin-view" data-view="inquiries">
            <div class="page-heading"><div><span class="eyebrow">Customer requests</span><h1>询盘中心</h1><p>跟进客户需求，及时把报价变成订单。</p></div><button class="primary-button" id="mark-all-read"><span>✓</span> 全部标为已读</button></div>
            <div class="inquiry-stats"><div><span class="inquiry-stat-icon icon-amber">!</span><span><strong>2</strong><small>新询盘</small></span></div><div><span class="inquiry-stat-icon icon-blue">◷</span><span><strong>2</strong><small>跟进中</small></span></div><div><span class="inquiry-stat-icon icon-green">✓</span><span><strong>1</strong><small>已报价</small></span></div><div><span class="inquiry-stat-icon icon-gray">↗</span><span><strong>84%</strong><small>回复率</small></span></div></div>
            <div class="toolbar"><div class="search-wrap"><span>⌕</span><input id="inquiry-search" type="search" placeholder="搜索客户、公司或询盘编号…" /></div><select id="inquiry-filter" class="toolbar-select" aria-label="筛选询盘"><option value="all">全部询盘</option><option value="New">新询盘</option><option value="In review">跟进中</option><option value="Quoted">已报价</option><option value="Closed">已关闭</option></select><button class="ghost-button">下载列表 <span>↓</span></button></div>
            <div class="panel table-panel"><div class="table-caption"><span><strong id="inquiry-result-count">{inquirySeed.length}</strong> 条询盘</span><span class="caption-muted">按最近收到时间排序</span></div><div class="table-scroll"><table class="data-table inquiry-table"><thead><tr><th>客户</th><th>需求</th><th>收到时间</th><th>优先级</th><th>状态</th><th></th></tr></thead><tbody id="inquiry-table-body">{inquirySeed.map((inquiry) => <tr data-inquiry-row data-search={`${inquiry.id} ${inquiry.customer} ${inquiry.company} ${inquiry.request}`.toLowerCase()} data-inquiry-status={inquiry.status}><td><div class="customer-cell"><span class={`inquiry-avatar avatar-${inquiry.tone}`}>{inquiry.initials}</span><span><strong>{inquiry.customer}</strong><small>{inquiry.company}<br />{inquiry.id}</small></span></div></td><td><strong>{inquiry.request}</strong></td><td><span class="date-cell">{inquiry.date}</span></td><td><em class={`priority priority-${inquiry.priority.toLowerCase()}`}>{inquiry.priority}</em></td><td><span class={`table-status status-${inquiry.status.toLowerCase().replace(' ', '-')}`}>{inquiry.status === 'In review' ? 'In review' : inquiry.status}</span></td><td><button class="row-link open-inquiry" data-inquiry-id={inquiry.id}>查看 →</button></td></tr>)}</tbody></table></div><div class="empty-state" id="inquiry-empty">没有找到匹配的询盘。</div></div>
          </section>

          <section class="admin-view" data-view="settings">
            <div class="page-heading"><div><span class="eyebrow">Store preferences</span><h1>设置</h1><p>调整商店信息和询盘通知方式。</p></div><button class="primary-button" id="save-settings"><span>✓</span> 保存设置</button></div>
            <div class="settings-grid"><div class="panel settings-panel"><div class="panel-heading"><div><span class="eyebrow">Store profile</span><h2>商店资料</h2></div></div><label class="settings-field"><span>公司名称</span><input value="M. H. S. City" /></label><label class="settings-field"><span>商店名称</span><input value="Coding Machine Store" /></label><label class="settings-field"><span>公司地址</span><input value="203 Qiaoxi Street, Shuitou Town, Nanan City, Quanzhou City, Fujian Province" /></label><label class="settings-field"><span>地区</span><input value="Quanzhou City · Fujian Province · Mainland, China" /></label><label class="settings-field"><span>联系邮箱</span><input value="info@codingmachinestore.com" type="email" /></label><label class="settings-field"><span>WhatsApp</span><input value="+86 187 0262 0038" /></label><label class="settings-field"><span>默认货币</span><select><option>USD — US Dollar</option><option>CNY — Chinese Yuan</option></select></label></div><div class="panel settings-panel"><div class="panel-heading"><div><span class="eyebrow">Notifications</span><h2>通知偏好</h2></div></div><label class="toggle-row"><span><strong>新询盘邮件提醒</strong><small>有人提交询盘时发送邮件</small></span><input type="checkbox" checked /><i class="toggle-ui"></i></label><label class="toggle-row"><span><strong>低库存提醒</strong><small>库存低于 10 件时提醒</small></span><input type="checkbox" checked /><i class="toggle-ui"></i></label><label class="toggle-row"><span><strong>每日运营摘要</strong><small>每天早上收到店铺概览</small></span><input type="checkbox" /><i class="toggle-ui"></i></label><div class="settings-callout"><span>i</span><p>设置目前保存在当前浏览器中。接入真实账号和数据库后，可以同步到云端。</p></div></div></div>
          </section>
        </div>
      </main>
    </div>

    <div class="modal-backdrop" id="product-modal" aria-hidden="true"><div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="product-modal-title"><div class="modal-heading"><div><span class="eyebrow">Catalogue action</span><h2 id="product-modal-title">新增商品</h2></div><button class="modal-close" data-close-modal="product-modal" aria-label="关闭">×</button></div><form id="product-form"><label><span>商品名称</span><input name="name" required placeholder="例如：Automatic Inkjet Printer" /></label><div class="form-two-col"><label><span>型号</span><input name="model" required placeholder="例如：CIJ-900" /></label><label><span>价格（USD）</span><input name="price" type="number" min="0" step="0.01" required placeholder="0.00" /></label></div><label><span>分类</span><select name="category"><option>Inkjet printer</option><option>Ribbon coding machine</option><option>Ink roller coder</option><option>Consumable</option></select></label><label><span>简短描述</span><textarea name="description" rows="3" placeholder="一句话介绍这款商品…"></textarea></label><div class="modal-actions"><button type="button" class="ghost-button" data-close-modal="product-modal">取消</button><button class="primary-button" type="submit">添加到目录 <span>→</span></button></div></form></div></div>
    <div class="toast" id="toast" role="status" aria-live="polite"><span>✓</span><span id="toast-message">已保存</span></div>

    <script>
      const navItems = [...document.querySelectorAll('[data-view-target]')];
      const views = [...document.querySelectorAll('[data-view]')];
      const breadcrumbCurrent = document.querySelector('#breadcrumb-current');
      const viewLabels = { overview: '总览', products: '商品目录', inquiries: '询盘中心', settings: '设置' };
      const sidebar = document.querySelector('#admin-sidebar');
      const mobileMenu = document.querySelector('#mobile-menu');
      const toast = document.querySelector('#toast');
      let toastTimer;

      function showToast(message) {
        document.querySelector('#toast-message').textContent = message;
        toast.classList.add('is-visible');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('is-visible'), 2600);
      }

      function switchView(viewName) {
        views.forEach((view) => view.classList.toggle('is-visible', view.dataset.view === viewName));
        navItems.forEach((item) => item.classList.toggle('is-active', item.dataset.viewTarget === viewName));
        breadcrumbCurrent.textContent = viewLabels[viewName] || viewName;
        sidebar.classList.remove('is-open');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      navItems.forEach((item) => item.addEventListener('click', () => switchView(item.dataset.viewTarget)));
      document.querySelectorAll('[data-switch-view]').forEach((item) => item.addEventListener('click', () => switchView(item.dataset.switchView)));
      mobileMenu.addEventListener('click', () => sidebar.classList.toggle('is-open'));

      function filterRows(inputId, filterId, rowSelector, emptyId, countId, searchAttribute, statusAttribute) {
        const input = document.querySelector(inputId);
        const filter = document.querySelector(filterId);
        const rows = [...document.querySelectorAll(rowSelector)];
        const apply = () => {
          const query = input.value.trim().toLowerCase();
          const selected = filter.value;
          let visible = 0;
          rows.forEach((row) => {
            const matchesQuery = !query || row.dataset[searchAttribute].includes(query);
            const matchesFilter = selected === 'all' || row.dataset[statusAttribute] === selected;
            const show = matchesQuery && matchesFilter;
            row.hidden = !show;
            if (show) visible += 1;
          });
          document.querySelector(countId).textContent = visible;
          document.querySelector(emptyId).classList.toggle('is-visible', visible === 0);
        };
        input.addEventListener('input', apply);
        filter.addEventListener('change', apply);
      }

      filterRows('#product-search', '#product-filter', '[data-product-row]', '#product-empty', '#product-result-count', 'name', 'status');
      filterRows('#inquiry-search', '#inquiry-filter', '[data-inquiry-row]', '#inquiry-empty', '#inquiry-result-count', 'search', 'inquiryStatus');

      function openModal(id) { const modal = document.querySelector(`#${id}`); modal.classList.add('is-visible'); modal.setAttribute('aria-hidden', 'false'); modal.querySelector('input')?.focus(); }
      function closeModal(id) { const modal = document.querySelector(`#${id}`); modal.classList.remove('is-visible'); modal.setAttribute('aria-hidden', 'true'); }
      document.querySelectorAll('[data-open-modal]').forEach((button) => button.addEventListener('click', () => openModal(button.dataset.openModal)));
      document.querySelectorAll('[data-close-modal]').forEach((button) => button.addEventListener('click', () => closeModal(button.dataset.closeModal)));
      document.querySelectorAll('.modal-backdrop').forEach((modal) => modal.addEventListener('click', (event) => { if (event.target === modal) closeModal(modal.id); }));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') document.querySelectorAll('.modal-backdrop.is-visible').forEach((modal) => closeModal(modal.id)); });

      function escapeHtml(value) { return String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char])); }
      document.querySelector('#product-form').addEventListener('submit', (event) => {
        event.preventDefault();
        const form = new FormData(event.currentTarget);
        const name = form.get('name');
        const model = form.get('model');
        const price = Number(form.get('price') || 0).toFixed(2);
        const category = form.get('category');
        const description = form.get('description') || 'New product ready to be configured.';
        const tbody = document.querySelector('#product-table-body');
        const row = document.createElement('tr');
        row.dataset.productRow = '';
        row.dataset.name = `${name} ${model} ${category}`.toLowerCase();
        row.dataset.stock = '0';
        row.dataset.status = 'draft';
        row.innerHTML = `<td><div class="product-cell"><span class="product-thumb product-thumb-placeholder">＋</span><span><strong>${escapeHtml(name)}</strong><small>${escapeHtml(model)}</small></span></div></td><td><span class="category-tag">${escapeHtml(category)}</span></td><td><strong class="price-cell">$${price}</strong></td><td><span class="stock-value stock-low"><i></i>0 units</span></td><td><span class="table-status status-draft">Draft</span></td><td><div class="row-actions"><button class="icon-button" title="编辑商品">⋯</button><span class="row-link">—</span></div></td>`;
        tbody.prepend(row);
        closeModal('product-modal');
        event.currentTarget.reset();
        document.querySelector('#product-filter').value = 'all';
        document.querySelector('#product-search').value = '';
        document.querySelector('#product-result-count').textContent = document.querySelectorAll('[data-product-row]').length;
        showToast(`${name} 已加入目录草稿`);
        switchView('products');
      });

      document.querySelectorAll('.edit-product').forEach((button) => button.addEventListener('click', () => showToast(`已打开 ${button.dataset.product} 的编辑入口`)));
      document.querySelectorAll('.open-inquiry, .inquiry-preview').forEach((button) => button.addEventListener('click', () => showToast(`已打开询盘 ${button.dataset.inquiryId}`)));
      document.querySelector('#mark-all-read').addEventListener('click', () => showToast('5 条询盘已标记为已读'));
      document.querySelector('#save-settings').addEventListener('click', () => showToast('设置已保存到当前浏览器'));
    </script>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
