---
import SiteLayout from '../layouts/SiteLayout.astro';
import AddToCartButton from '../components/AddToCartButton';
import QuoteForm from '../components/QuoteForm';
import { categories } from '../data/categories';
import { products } from '../data/products';
const featuredCategories = categories.filter((category) => category.featured);
const homepageProducts = products.filter((product) => !product.slug.startsWith('copper-type'));
---
<SiteLayout title="Coding Machine Store | Inkjet & Coding Equipment">
  <section class="hero"><div><span class="eyebrow">Factory-direct · Ruian, Zhejiang, China</span><h1>Mark every product clearly.</h1><p class="hero-copy">Factory-direct coding equipment from Ruian, Zhejiang — hot ribbon coders, pneumatic coders and ink wheel coders for date, batch and expiry coding on flexible packaging and production lines. Clear specifications, direct pricing and practical support.</p><div class="hero-actions"><a class="button button-dark" href="/products/">Browse products</a><a class="text-link" href="#products">See featured models ↓</a></div></div><div class="hero-media"><img src="/assets/generated/hero-coding-machine.png" alt="Coding machine and packaging materials" /></div></section>
  <section class="section" id="categories"><div class="section-heading"><div><span class="eyebrow">Shop by application</span><h2>Start with the right coding system.</h2></div><p class="section-intro">Choose one of the three machine families. Matching machine parts and supplies are organized separately under Consumables.</p></div><div class="category-grid">{featuredCategories.map((category) => <a class="category-card" href={`/category/${category.slug}/`}><span class="eyebrow">{category.label}</span><strong>{category.title}</strong><p>{category.description}</p><span>View category →</span></a>)}</div></section>
  <section class="section" id="products"><div class="section-heading"><div><span class="eyebrow">Ready to quote</span><h2>Current products.</h2></div><div><p class="section-intro">Nine coding machines are ready to quote: manual, electric and pneumatic hot ribbon coders, plus hot ink roll, ink wheel and automatic solid ink roll coders. Each product page contains its specifications and requirements. Prices are in USD and exclude shipping.</p><a class="text-link" href="/products/">Open the full product catalogue →</a></div></div><div class="product-grid">{homepageProducts.map((product) => <article class="product-card"><a class="product-card-media" href={`/products/${product.slug}/`}><img src={product.hero} alt={product.name} /></a><div class="product-card-body"><span class="eyebrow">{product.model} · {product.type}</span><h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3><p>{product.description}</p><div class="product-meta"><span class="price">{product.priceLabel ?? `$${product.price.toFixed(2)}`}</span>{product.options?.length ? <a class="button button-dark add-cart-button" href={`/products/${product.slug}/`}>Choose SKU</a> : <AddToCartButton client:load id={product.slug} name={`${product.model} ${product.name}`} price={product.price} />}</div></div></article>)}</div></section>
  <section class="section quote-section" id="quote"><div class="section-heading"><div><span class="eyebrow">Shipping calculated separately</span><h2>Build a quote list.</h2></div><p class="section-intro">Add products to the cart, then complete this form. Formspree sends the request to us, and we will reply by email or WhatsApp with the available shipping option.</p></div><QuoteForm client:load /></section>
</SiteLayout>
