---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomepageShowcase from '../components/HomepageShowcase';
import QuoteForm from '../components/QuoteForm';
import { categories } from '../data/categories';
import { products } from '../data/products';
const featuredCategories = categories.filter((category) => category.featured);
const machineCategories = ['ribbon-coding-machines', 'ink-wheel-coders', 'inkjet-printers'];
const homepageProducts = products.filter((product) => machineCategories.includes(product.category));
const machineCount = homepageProducts.length;
const consumableCount = products.length - machineCount;
---
<SiteLayout title="Coding Machine Store | Inkjet & Coding Equipment">
  <section class="hero"><div><span class="eyebrow">Factory-direct · Ruian, Zhejiang, China</span><h1>Mark every product clearly.</h1><p class="hero-copy">Factory-direct coding equipment from Ruian, Zhejiang — hot ribbon coders, pneumatic coders, ink wheel coders and handheld, online, desktop and conveyor thermal inkjet printers for date, batch and expiry coding on flexible packaging and production lines. Clear specifications, direct pricing and practical support.</p><div class="hero-actions"><a class="button button-dark" href="/products/">Browse products</a><a class="text-link" href="#products">See featured models ↓</a></div></div><div class="hero-media"><img src="/assets/generated/hero-real-machines-v2.png" alt="HP-241 ribbon coder, MY-380F ink wheel coder, K90 desktop inkjet printer and A5 handheld inkjet printer" /></div></section>
  <section class="section" id="categories"><div class="section-heading"><div><span class="eyebrow">Shop by application</span><h2>Start with the right coding system.</h2></div><p class="section-intro">Choose one of the three machine families. Matching machine parts and supplies are organized separately under Consumables.</p></div><div class="category-grid">{featuredCategories.map((category) => <a class="category-card" href={`/category/${category.slug}/`}><span class="eyebrow">{category.label}</span><strong>{category.title}</strong><p>{category.description}</p><span>View category →</span></a>)}</div></section>
  <section class="section" id="products"><div class="section-heading"><div><span class="eyebrow">Ready to quote</span><h2>Current products.</h2></div><div><p class="section-intro">{machineCount} coding machines are ready to quote: manual, electric and pneumatic hot ribbon coders, hot ink roll, ink wheel and automatic solid ink roll coders, plus handheld, online, desktop and conveyor thermal inkjet printers. Matching ribbons, ink rolls, type characters and TIJ cartridges are listed under Consumables ({consumableCount} products). Each product page contains its specifications and requirements. Prices are in USD and exclude shipping.</p><a class="text-link" href="/products/">Open the full product catalogue →</a></div></div><HomepageShowcase client:load products={homepageProducts.map((product) => ({ slug: product.slug, model: product.model, name: product.name, type: product.type, description: product.description, hero: product.hero, price: product.price, priceLabel: product.priceLabel ?? null, hasOptions: Boolean(product.options?.length) }))} /></section>
  <section class="section" id="how-ordering"><div class="section-heading"><div><span class="eyebrow">How ordering works</span><h2>From quote to delivery.</h2></div><p class="section-intro">No minimum order — order a single unit or a full line. Every product is priced per unit in USD, excluding shipping.</p></div><div class="category-grid"><div class="category-card"><span class="eyebrow">Step 1</span><strong>Add to your quote list</strong><p>Choose the model, size and quantity on each product page, then add it to your quote list.</p></div><div class="category-card"><span class="eyebrow">Step 2</span><strong>Send the quote form</strong><p>Complete the form below with your delivery address. We reply by email or WhatsApp with the shipping cost and availability.</p></div><div class="category-card"><span class="eyebrow">Step 3</span><strong>Volume pricing</strong><p>Ordering 10 or more units of a machine? Ask for volume pricing — 10-set prices are below the single-unit price. Shipping is quoted separately for your address.</p></div></div></section>
  <section class="section quote-section" id="quote"><div class="section-heading"><div><span class="eyebrow">Shipping calculated separately</span><h2>Build a quote list.</h2></div><p class="section-intro">Add products to the cart, then complete this form. Formspree sends the request to us, and we will reply by email or WhatsApp with the available shipping option.</p></div><QuoteForm client:load /></section>
</SiteLayout>
