---
import '../styles/global.css';
import CartIsland from '../components/CartIsland';
const { title = 'Coding Machine Store', description = 'Factory-direct coding equipment from Quanzhou, China.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="icon" href="/favicon.svg" /><title>{title}</title></head>
  <body>
    <header class="site-header"><a class="brand" href="/">CODING<span>MACHINE</span>STORE</a><nav class="main-nav" aria-label="Main navigation"><a href="/">Home</a><details class="nav-menu"><summary>Products</summary><div class="nav-menu-panel"><a class="nav-product-link" href="/category/ribbon-coding-machines/">Ribbon Coding Machine</a><a class="nav-subitem" href="/category/ribbon-machine-parts/">Machine part</a><a class="nav-subitem" href="/category/ribbon-consumables/">Ribbon</a><a class="nav-product-link" href="/category/ink-wheel-coders/">Ink Roller Coding Machine</a><a class="nav-subitem" href="/category/ink-roller-machine-parts/">Machine part</a><a class="nav-subitem" href="/category/ink-roller-consumables/">Ink roller</a><a class="nav-product-link" href="/category/inkjet-printers/">Inkjet Printer</a><a class="nav-subitem" href="/category/cartridge-machine-parts/">Machine part</a><a class="nav-subitem" href="/category/cartridges/">Cartridge</a></div></details></nav><CartIsland client:load /></header>
    <main><slot /></main>
    <footer class="site-footer"><div><span class="eyebrow">CODING MACHINE STORE</span><p>Factory-direct coding equipment from Quanzhou, China.</p></div><div class="footer-contact"><a href="mailto:info@codingmachinestore.com">info@codingmachinestore.com</a><a href="https://wa.me/8618702620038">WhatsApp +86 187 0262 0038</a></div></footer>
  </body>
</html>
